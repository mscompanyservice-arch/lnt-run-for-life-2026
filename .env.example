# Copy to .env (never commit .env). Placeholders only.

# PostgreSQL connection string (PostgreSQL 13+)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Set to true for managed databases that require TLS (Supabase, Render, Neon, etc.)
DATABASE_SSL=false
# Optional: false only if your provider uses a certificate Node cannot verify
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10

# Long random secret (at least 32 chars). Generate: openssl rand -hex 32
# Changing it later does NOT break existing access codes (they are stored hashed).
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

PORT=3000
# Keep true in production (HTTPS). Set false only for local http testing.
COOKIE_SECURE=true
# Number of reverse proxies in front of the app (1 behind Caddy/Nginx/Render/Cloudflare). Needed for correct rate limiting.
TRUST_PROXY=1
# Apply database migrations automatically at startup
MIGRATE_ON_START=true
